
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Check authentication
    function signedIn() {
      return request.auth != null;
    }

    // Get the signed-in user's profile
    function userData() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    // Check admin role
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        userData().role == 'admin';
    }

    // Check Panchayat village access
    function isPanchayat(villageId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        userData().role == 'panchayat' &&
        userData().villageId == villageId;
    }

    // Validate complaint data
    function validComplaint(data) {
      return data.keys().hasAll([
        'complaintId',
        'villageId',
        'villageCode',
        'problemType',
        'description',
        'laneName',
        'location',
        'status',
        'statusHistory',
        'residentUid',
        'residentMobile',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'complaintId',
        'villageId',
        'villageCode',
        'problemType',
        'description',
        'laneName',
        'photoUrl',
        'location',
        'status',
        'remarks',
        'statusHistory',
        'residentUid',
        'residentMobile',
        'createdAt',
        'updatedAt'
      ]) &&
      data.complaintId is string &&
      data.villageId is string &&
      data.villageCode is string &&
      data.problemType in [
        'drain',
        'stagnant_water',
        'mosquito',
        'street_light',
        'waste_collection',
        'drinking_water',
        'other'
      ] &&
      data.description is string &&
      data.description.size() <= 500 &&
      data.laneName is string &&
      data.laneName.size() > 0 &&
      data.laneName.size() <= 200 &&
      data.residentUid is string &&
      data.residentMobile is string &&
      data.location is map &&
      data.location.verified is bool &&
      data.status == 'received' &&
      data.statusHistory is list &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp &&
      (
        data.problemType == 'other' ||
        (
          'photoUrl' in data &&
          data.photoUrl is string &&
          data.photoUrl.size() > 0
        )
      ) &&
      exists(
        /databases/$(database)/documents/villages/$(data.villageId)
      );
    }

    // Villages
    match /villages/{villageId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // User profiles
    match /users/{userId} {

      allow get: if signedIn() &&
        (request.auth.uid == userId || isAdmin());

      allow list: if isAdmin();

      // Residents can create only their own resident profile.
      // Panchayat and admin profiles must be created by an administrator.
      allow create: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.uid == userId &&
        request.resource.data.role == 'resident' &&
        request.resource.data.keys().hasOnly([
          'uid', 'role', 'mobile', 'createdAt'
        ]);

      // Users cannot change their own role or village assignment.
      allow update: if isAdmin();

      allow delete: if false;
    }

    // Complaints
    match /complaints/{complaintDocId} {

      // Residents see their own complaints.
      // Panchayat sees only complaints from its assigned village.
      allow get, list: if signedIn() && (
        resource.data.residentUid == request.auth.uid ||
        isPanchayat(resource.data.villageId) ||
        isAdmin()
      );

      // Residents can submit complaints for themselves.
      allow create: if signedIn() &&
        validComplaint(request.resource.data) &&
        request.resource.data.residentUid == request.auth.uid &&
        request.resource.data.status == 'received';

      // Only the assigned Panchayat can update complaint status.
      allow update: if signedIn() &&
        isPanchayat(resource.data.villageId) &&
        request.resource.data.villageId == resource.data.villageId &&
        request.resource.data.residentUid == resource.data.residentUid &&
        request.resource.data.complaintId == resource.data.complaintId &&
        request.resource.data.status in [
          'received', 'in_progress', 'resolved'
        ] &&
        request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status', 'remarks', 'statusHistory', 'updatedAt'
          ]);

      // Complaints cannot be deleted from the client.
      allow delete: if false;
    }

    // Complaint counters are server-managed.
    // Use a trusted Cloud Function with the Admin SDK.
    match /counters/{counterId} {
      allow read, write: if false;
    }

  }
}
